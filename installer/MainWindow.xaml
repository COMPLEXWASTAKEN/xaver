<Window x:Class="XaverSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xaver Setup"
        Width="828" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="Taskbar" />
  </Window.TaskbarItemInfo>

  <Grid Margin="24">
    <Border x:Name="Shell" CornerRadius="22" Background="{StaticResource Bg0}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5" Opacity="0">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="Black" Direction="270" />
      </Border.Effect>
      <Border.RenderTransform>
        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
      </Border.RenderTransform>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="268" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="21,0,0,21" ClipToBounds="True" Background="{StaticResource Bg1}">
          <Grid ClipToBounds="True">
            <Ellipse x:Name="GlowA" Width="420" Height="420" Margin="-190,-170,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#88FF5A3C" Offset="0" />
                  <GradientStop Color="#22FF5A3C" Offset="0.45" />
                  <GradientStop Color="#00FF5A3C" Offset="1" />
                </RadialGradientBrush>
              </Ellipse.Fill>
              <Ellipse.RenderTransform>
                <TranslateTransform />
              </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="GlowB" Width="360" Height="360" Margin="0,0,-200,-150" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#44FFC4A8" Offset="0" />
                  <GradientStop Color="#00FFC4A8" Offset="1" />
                </RadialGradientBrush>
              </Ellipse.Fill>
              <Ellipse.RenderTransform>
                <TranslateTransform />
              </Ellipse.RenderTransform>
            </Ellipse>

            <DockPanel Margin="30,34,26,26">
              <StackPanel DockPanel.Dock="Top">
                <Image x:Name="Logo" Source="pack://application:,,,/XaverSetup;component/assets/logo.png" Width="62" Height="62" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality">
                  <Image.Effect>
                    <DropShadowEffect Color="#FFFF5A3C" BlurRadius="26" ShadowDepth="0" Opacity="0.55" />
                  </Image.Effect>
                  <Image.RenderTransform>
                    <TranslateTransform />
                  </Image.RenderTransform>
                </Image>
                <TextBlock Text="Xaver" FontSize="21" FontWeight="Bold" Margin="0,20,0,0" />
                <Border HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,3" CornerRadius="999" Background="{StaticResource AccentSoft}" BorderBrush="#55FF5A3C" BorderThickness="1">
                  <TextBlock x:Name="VersionPill" Text="v0.0.0" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFC4A8" FontFamily="{StaticResource MonoFont}" />
                </Border>
              </StackPanel>

              <TextBlock DockPanel.Dock="Bottom" x:Name="HeroFoot" Text="Installs just for you · no admin needed" FontSize="11" Foreground="{StaticResource Mute}" TextWrapping="Wrap" />

              <StackPanel x:Name="Steps" VerticalAlignment="Center" Margin="0,10,0,10" />
            </DockPanel>
          </Grid>
        </Border>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid x:Name="TitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,10,0">
              <Button x:Name="BtnMin" Style="{StaticResource ChromeButton}" ToolTip="Minimise">
                <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
              </Button>
              <Button x:Name="BtnClose" Style="{StaticResource ChromeButton}" Tag="close" ToolTip="Close" Margin="4,0,0,0">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Button>
            </StackPanel>
          </Grid>

          <Grid x:Name="Pages" Grid.Row="1" Margin="40,0,40,0" ClipToBounds="False">

            <StackPanel x:Name="PageWelcome" VerticalAlignment="Center">
              <TextBlock x:Name="WelcomeKicker" Style="{StaticResource Kicker}" Text="WELCOME" />
              <TextBlock x:Name="WelcomeTitle" Style="{StaticResource H1}" Margin="0,8,0,0" Text="Install Xaver" />
              <TextBlock x:Name="WelcomeLead" Style="{StaticResource Lead}" Margin="0,10,0,0" />
              <Border x:Name="UpgradeCard" Margin="0,22,0,0" Padding="16,14" CornerRadius="16" Background="#0AF4EFE6" BorderBrush="{StaticResource Line}" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="8,3" CornerRadius="8" Background="{StaticResource Bg3}">
                      <TextBlock x:Name="FromVersion" Text="2.0.6" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Dim}" />
                    </Border>
                    <TextBlock Text="→" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontSize="15" />
                    <Border Padding="8,3" CornerRadius="8" Background="{StaticResource AccentSoft}">
                      <TextBlock x:Name="ToVersion" Text="2.0.7" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#FFFFC4A8" />
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="UpgradeNote" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Lead}" FontSize="12.5"
                             Text="Your library, settings and login stay exactly as they are." />
                </Grid>
              </Border>
              <StackPanel x:Name="Features" Margin="0,24,0,0" />
            </StackPanel>

            <StackPanel x:Name="PageOptions" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock x:Name="OptionsKicker" Style="{StaticResource Kicker}" Text="OPTIONS" />
              <TextBlock x:Name="OptionsTitle" Style="{StaticResource H1}" Margin="0,8,0,0" Text="Where should it go?" />
              <StackPanel x:Name="LocationGroup">
                <TextBlock Text="Install location" Margin="0,22,0,8" FontSize="12" Foreground="{StaticResource Dim}" FontWeight="SemiBold" />
                <DockPanel>
                  <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Browse…" Margin="10,0,0,0" Padding="16,9" />
                  <TextBox x:Name="PathBox" Style="{StaticResource Field}" />
                </DockPanel>
                <TextBlock x:Name="SpaceText" Margin="2,8,0,0" FontSize="11.5" Foreground="{StaticResource Mute}" />
              </StackPanel>
              <StackPanel x:Name="InstallSwitches" Margin="-12,16,-12,0">
                <CheckBox x:Name="ChkDesktop" Style="{StaticResource Switch}" Content="Desktop shortcut" IsChecked="True" />
                <CheckBox x:Name="ChkStart" Style="{StaticResource Switch}" Content="Start menu shortcut" IsChecked="True" />
                <CheckBox x:Name="ChkLaunch" Style="{StaticResource Switch}" Content="Open Xaver when setup finishes" IsChecked="True" />
              </StackPanel>
              <StackPanel x:Name="UninstallSwitches" Margin="-12,16,-12,0" Visibility="Collapsed">
                <CheckBox x:Name="ChkPurge" Style="{StaticResource Switch}" IsChecked="False">
                  <StackPanel>
                    <TextBlock Text="Also delete my settings, database and login" />
                    <TextBlock Text="Downloaded photos and videos in your output folder are never touched." FontSize="11.5" Foreground="{StaticResource Mute}" Margin="0,3,0,0" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </StackPanel>

            <StackPanel x:Name="PageProgress" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock x:Name="ProgressKicker" Style="{StaticResource Kicker}" Text="INSTALLING" />
              <TextBlock x:Name="ProgressTitle" Style="{StaticResource H1}" Margin="0,8,0,0" Text="Setting things up" />
              <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                <TextBlock x:Name="PercentText" Text="0" FontSize="58" FontWeight="Bold" />
                <TextBlock Text="%" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Dim}" VerticalAlignment="Bottom" Margin="4,0,0,12" />
              </StackPanel>
              <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Margin="0,8,0,0" Value="0" />
              <TextBlock x:Name="StatusText" Margin="0,14,0,0" FontSize="13.5" FontWeight="SemiBold" Text="Getting ready" />
              <TextBlock x:Name="DetailText" Margin="0,5,0,0" FontSize="11.5" Foreground="{StaticResource Mute}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel x:Name="PageDone" VerticalAlignment="Center" Visibility="Collapsed">
              <Grid Width="92" Height="92" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" x:Name="DoneBadge">
                <Grid.RenderTransform>
                  <ScaleTransform ScaleX="0.4" ScaleY="0.4" />
                </Grid.RenderTransform>
                <Ellipse Fill="{StaticResource AccentSoft}" Stroke="{StaticResource Accent}" StrokeThickness="2" />
                <Path x:Name="DoneCheck" Data="M 27,47 L 41,61 L 66,33" Stroke="{StaticResource Accent}" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="10 10" StrokeDashOffset="10" />
              </Grid>
              <TextBlock x:Name="DoneTitle" Style="{StaticResource H1}" Margin="0,24,0,0" Text="You're all set" />
              <TextBlock x:Name="DoneLead" Style="{StaticResource Lead}" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel x:Name="PageError" VerticalAlignment="Center" Visibility="Collapsed">
              <Grid Width="72" Height="72" HorizontalAlignment="Left">
                <Ellipse Fill="#1FE07A7A" Stroke="{StaticResource Err}" StrokeThickness="2" />
                <TextBlock Text="!" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Err}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="ErrorTitle" Style="{StaticResource H1}" Margin="0,22,0,0" Text="That didn't work" />
              <TextBlock x:Name="ErrorText" Style="{StaticResource Lead}" Margin="0,10,0,0" />
              <TextBlock x:Name="ErrorSafe" Style="{StaticResource Lead}" Margin="0,10,0,0" FontSize="12.5" Foreground="{StaticResource Mute}"
                         Text="Nothing was left half-installed. Your previous version is untouched." />
            </StackPanel>
          </Grid>

          <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,16,24,18">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Style="{StaticResource LinkButton}" Content="Cancel" Margin="0,0,6,0" />
                <Button x:Name="BtnBack" Style="{StaticResource GhostButton}" Content="Back" Margin="0,0,10,0" MinWidth="84" />
                <Button x:Name="BtnPrimary" Style="{StaticResource PrimaryButton}" Content="Next" MinWidth="120" IsDefault="True" />
              </StackPanel>
              <Button x:Name="BtnLog" Style="{StaticResource LinkButton}" Content="View log" HorizontalAlignment="Left" Visibility="Collapsed" Padding="4,9" />
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
